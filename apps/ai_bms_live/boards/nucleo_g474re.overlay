/* DAC channel 1 (PA4) for cell-V simulation; ADC channel 1 (PA0)
 * for sampling. User connects PA4 ↔ PA0 with a single jumper wire.
 *
 * Both pins are already pinmuxed in the base board DTS, but we add an
 * io-channel-cells alias so adc.h's DT_SPEC_GET helpers find them.
 */
/ {
	zephyr,user {
		io-channels = <&adc1 1>;
		dac = <&dac1>;
		dac-channel-id = <1>;
		dac-resolution = <12>;
	};
};

&adc1 {
	#address-cells = <1>;
	#size-cells = <0>;

	channel@1 {
		reg = <1>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_TICKS, 47)>;
		zephyr,resolution = <12>;
	};
};
