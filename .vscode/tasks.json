{
  "version": "2.0.0",
  "options": {
    "env": {
      "ZEPHYR_BASE": "${workspaceFolder}/zephyr",
      "ZEPHYR_SDK_INSTALL_DIR": "/Users/dkkang/zephyr-sdk-1.0.1",
      "PATH": "${workspaceFolder}/.venv/bin:/opt/homebrew/bin:/usr/bin:/bin"
    }
  },
  "inputs": [
    {
      "id": "appPath",
      "type": "promptString",
      "description": "샘플/앱 경로 (예: zephyr/samples/basic/blinky)",
      "default": "zephyr/samples/basic/blinky"
    },
    {
      "id": "buildName",
      "type": "promptString",
      "description": "빌드 디렉토리 이름 (build/<name>)",
      "default": "blinky"
    }
  ],
  "tasks": [
    {
      "label": "Zephyr: Build (blinky)",
      "type": "shell",
      "command": "west",
      "args": [
        "build", "-p", "auto",
        "-b", "nucleo_g474re",
        "${workspaceFolder}/zephyr/samples/basic/blinky",
        "-d", "${workspaceFolder}/build/blinky"
      ],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Zephyr: Build (custom app)",
      "type": "shell",
      "command": "west",
      "args": [
        "build", "-p", "auto",
        "-b", "nucleo_g474re",
        "${workspaceFolder}/${input:appPath}",
        "-d", "${workspaceFolder}/build/${input:buildName}"
      ],
      "group": "build",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Zephyr: Pristine build (blinky)",
      "type": "shell",
      "command": "west",
      "args": [
        "build", "-p", "always",
        "-b", "nucleo_g474re",
        "${workspaceFolder}/zephyr/samples/basic/blinky",
        "-d", "${workspaceFolder}/build/blinky"
      ],
      "group": "build",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Zephyr: Debug build (blinky, -Og)",
      "type": "shell",
      "command": "west",
      "args": [
        "build", "-p", "always",
        "-b", "nucleo_g474re",
        "${workspaceFolder}/zephyr/samples/basic/blinky",
        "-d", "${workspaceFolder}/build/blinky",
        "--",
        "-DEXTRA_CONF_FILE=${workspaceFolder}/debug.conf"
      ],
      "group": "build",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Zephyr: Flash (blinky / openocd)",
      "type": "shell",
      "command": "west",
      "args": [
        "flash", "-r", "openocd",
        "-d", "${workspaceFolder}/build/blinky"
      ],
      "dependsOn": "Zephyr: Build (blinky)",
      "problemMatcher": []
    },
    {
      "label": "Zephyr: Build (shell_monitor)",
      "type": "shell",
      "command": "west",
      "args": [
        "build", "-p", "auto",
        "-b", "nucleo_g474re",
        "${workspaceFolder}/apps/shell_monitor",
        "-d", "${workspaceFolder}/build/shell_monitor"
      ],
      "group": "build",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Zephyr: Debug build (shell_monitor, -Og)",
      "type": "shell",
      "command": "west",
      "args": [
        "build", "-p", "always",
        "-b", "nucleo_g474re",
        "${workspaceFolder}/apps/shell_monitor",
        "-d", "${workspaceFolder}/build/shell_monitor",
        "--",
        "-DEXTRA_CONF_FILE=${workspaceFolder}/debug.conf"
      ],
      "group": "build",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Zephyr: Flash (shell_monitor / openocd)",
      "type": "shell",
      "command": "west",
      "args": [
        "flash", "-r", "openocd",
        "-d", "${workspaceFolder}/build/shell_monitor"
      ],
      "dependsOn": "Zephyr: Build (shell_monitor)",
      "problemMatcher": []
    },
    {
      "label": "Zephyr: Build (ai_sine)",
      "type": "shell",
      "command": "west",
      "args": [
        "build", "-p", "auto",
        "-b", "nucleo_g474re",
        "${workspaceFolder}/apps/ai_sine",
        "-d", "${workspaceFolder}/build/ai_sine"
      ],
      "group": "build",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Zephyr: Debug build (ai_sine, -Og)",
      "type": "shell",
      "command": "west",
      "args": [
        "build", "-p", "always",
        "-b", "nucleo_g474re",
        "${workspaceFolder}/apps/ai_sine",
        "-d", "${workspaceFolder}/build/ai_sine",
        "--",
        "-DEXTRA_CONF_FILE=${workspaceFolder}/debug.conf"
      ],
      "group": "build",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Zephyr: Flash (ai_sine / openocd)",
      "type": "shell",
      "command": "west",
      "args": [
        "flash", "-r", "openocd",
        "-d", "${workspaceFolder}/build/ai_sine"
      ],
      "dependsOn": "Zephyr: Build (ai_sine)",
      "problemMatcher": []
    },
    {
      "label": "Zephyr: Build (ai_anomaly)",
      "type": "shell",
      "command": "west",
      "args": [
        "build", "-p", "auto",
        "-b", "nucleo_g474re",
        "${workspaceFolder}/apps/ai_anomaly",
        "-d", "${workspaceFolder}/build/ai_anomaly"
      ],
      "group": "build",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Zephyr: Debug build (ai_anomaly, -Og)",
      "type": "shell",
      "command": "west",
      "args": [
        "build", "-p", "always",
        "-b", "nucleo_g474re",
        "${workspaceFolder}/apps/ai_anomaly",
        "-d", "${workspaceFolder}/build/ai_anomaly",
        "--",
        "-DEXTRA_CONF_FILE=${workspaceFolder}/debug.conf"
      ],
      "group": "build",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Zephyr: Flash (ai_anomaly / openocd)",
      "type": "shell",
      "command": "west",
      "args": [
        "flash", "-r", "openocd",
        "-d", "${workspaceFolder}/build/ai_anomaly"
      ],
      "dependsOn": "Zephyr: Build (ai_anomaly)",
      "problemMatcher": []
    },
    {
      "label": "Zephyr: Train ai_anomaly model",
      "type": "shell",
      "command": "${workspaceFolder}/.venv-ml/bin/python",
      "args": ["${workspaceFolder}/apps/ai_anomaly/train/train.py"],
      "options": {
        "cwd": "${workspaceFolder}/apps/ai_anomaly/train"
      },
      "problemMatcher": []
    },
    {
      "label": "Zephyr: Build (ai_bms)",
      "type": "shell",
      "command": "west",
      "args": [
        "build", "-p", "auto",
        "-b", "nucleo_g474re",
        "${workspaceFolder}/apps/ai_bms",
        "-d", "${workspaceFolder}/build/ai_bms"
      ],
      "group": "build",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Zephyr: Debug build (ai_bms, -Og)",
      "type": "shell",
      "command": "west",
      "args": [
        "build", "-p", "always",
        "-b", "nucleo_g474re",
        "${workspaceFolder}/apps/ai_bms",
        "-d", "${workspaceFolder}/build/ai_bms",
        "--",
        "-DEXTRA_CONF_FILE=${workspaceFolder}/debug.conf"
      ],
      "group": "build",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Zephyr: Flash (ai_bms / openocd)",
      "type": "shell",
      "command": "west",
      "args": [
        "flash", "-r", "openocd",
        "-d", "${workspaceFolder}/build/ai_bms"
      ],
      "dependsOn": "Zephyr: Build (ai_bms)",
      "problemMatcher": []
    },
    {
      "label": "Zephyr: Train ai_bms model",
      "type": "shell",
      "command": "${workspaceFolder}/.venv-ml/bin/python",
      "args": ["${workspaceFolder}/apps/ai_bms/train/train.py"],
      "options": {
        "cwd": "${workspaceFolder}/apps/ai_bms/train"
      },
      "problemMatcher": []
    },
    {
      "label": "Zephyr: Build (ai_bms_soh)",
      "type": "shell",
      "command": "west",
      "args": [
        "build", "-p", "auto",
        "-b", "nucleo_g474re",
        "${workspaceFolder}/apps/ai_bms_soh",
        "-d", "${workspaceFolder}/build/ai_bms_soh"
      ],
      "group": "build",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Zephyr: Debug build (ai_bms_soh, -Og)",
      "type": "shell",
      "command": "west",
      "args": [
        "build", "-p", "always",
        "-b", "nucleo_g474re",
        "${workspaceFolder}/apps/ai_bms_soh",
        "-d", "${workspaceFolder}/build/ai_bms_soh",
        "--",
        "-DEXTRA_CONF_FILE=${workspaceFolder}/debug.conf"
      ],
      "group": "build",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Zephyr: Flash (ai_bms_soh / openocd)",
      "type": "shell",
      "command": "west",
      "args": [
        "flash", "-r", "openocd",
        "-d", "${workspaceFolder}/build/ai_bms_soh"
      ],
      "dependsOn": "Zephyr: Build (ai_bms_soh)",
      "problemMatcher": []
    },
    {
      "label": "Zephyr: Train ai_bms_soh model",
      "type": "shell",
      "command": "${workspaceFolder}/.venv-ml/bin/python",
      "args": ["${workspaceFolder}/apps/ai_bms_soh/train/train.py"],
      "options": { "cwd": "${workspaceFolder}/apps/ai_bms_soh/train" },
      "problemMatcher": []
    },
    {
      "label": "Zephyr: Clean ai_bms_soh",
      "type": "shell",
      "command": "rm",
      "args": ["-rf", "${workspaceFolder}/build/ai_bms_soh"],
      "problemMatcher": []
    },
    {
      "label": "Zephyr: Clean ai_bms",
      "type": "shell",
      "command": "rm",
      "args": ["-rf", "${workspaceFolder}/build/ai_bms"],
      "problemMatcher": []
    },
    {
      "label": "Zephyr: Clean ai_anomaly",
      "type": "shell",
      "command": "rm",
      "args": ["-rf", "${workspaceFolder}/build/ai_anomaly"],
      "problemMatcher": []
    },
    {
      "label": "Zephyr: Clean ai_sine",
      "type": "shell",
      "command": "rm",
      "args": ["-rf", "${workspaceFolder}/build/ai_sine"],
      "problemMatcher": []
    },
    {
      "label": "Zephyr: Clean shell_monitor",
      "type": "shell",
      "command": "rm",
      "args": ["-rf", "${workspaceFolder}/build/shell_monitor"],
      "problemMatcher": []
    },
    {
      "label": "Zephyr: Clean blinky",
      "type": "shell",
      "command": "rm",
      "args": ["-rf", "${workspaceFolder}/build/blinky"],
      "problemMatcher": []
    },
    {
      "label": "Zephyr: Open Serial (115200)",
      "type": "shell",
      "command": "bash",
      "args": [
        "-lc",
        "PORT=$(ls /dev/cu.usbmodem* 2>/dev/null | head -1); if [ -z \"$PORT\" ]; then echo 'No /dev/cu.usbmodem* found'; exit 1; fi; echo \"Opening $PORT @ 115200 (Ctrl-A then K to quit screen)\"; exec screen \"$PORT\" 115200"
      ],
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": []
    }
  ]
}
