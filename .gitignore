# west-managed source trees (each is its own git repo, managed by `west update`)
/zephyr/
/modules/
/bootloader/
/tools/
/optional/

# west workspace metadata (regenerable via `west init -l zephyr`)
/.west/

# Python venvs (west .venv + ML training .venv-ml)
/.venv/
/.venv-ml/

# Build output
/build/
build/

# IDE / OS junk
.DS_Store
*.swp
*.swo

# Python
__pycache__/
*.pyc

# Generated training artifacts (model.cpp is the artifact we ship)
apps/*/train/model.tflite

# Raw datasets — too large to commit; each developer downloads their own.
# datasets/README.md has reproduce instructions; datasets/*/ is gitignored
# but datasets/README.md itself stays tracked.
apps/*/train/data/
datasets/*/
!datasets/README.md

# Claude memory (kept outside this repo)
/.claude/
